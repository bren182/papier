{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "checkJs": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "maxNodeModuleJsDepth": 0,
    "noEmit": true
  },
  "include": [
    "src"
  ]
}
