{
  "name": "papier",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @papier/server --filter @papier/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "pnpm --filter @papier/web test:e2e"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
